<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PillShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Details page (V33) -->

    <style name="SeasonChip" parent="@style/Widget.Material3.Chip.Filter">
        <item name="chipMinTouchTargetSize">0dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipMaxHeight">36dp</item>
        <item name="chipStartPadding">16dp</item>
        <item name="chipEndPadding">16dp</item>
        <item name="chipCornerRadius">10dp</item>
        <item name="chipStrokeColor">#3F3F46</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipBackgroundColor">@color/season_chip_bg</item>
        <item name="android:textColor">@color/season_chip_text</item>
        <item name="textColor">@color/season_chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconTint">#0E0E10</item>
    </style>

    <style name="KinoMetaText" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:background">@drawable/bg_meta_pill</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">#E4E4E7</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="KinoSelectorPill" parent="@style/BlackButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#E4E4E7</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">#3F3F46</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="ResultTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#A1A1AA</item>
        <item name="textAllCaps">false</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
</resources>
