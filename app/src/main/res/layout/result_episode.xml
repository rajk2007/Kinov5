<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/episode_holder"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginBottom="10dp"
    android:foreground="@drawable/outline_drawable"
    android:nextFocusRight="@id/download_button"
    app:cardBackgroundColor="#0E0E10"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <!-- V33: episodes without a poster and description use this row. Same fix as the large card:
         the download button overlays the row inside a FrameLayout instead of using a negative margin. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="44dp">

            <FrameLayout
                android:id="@+id/watch_progress_container"
                android:layout_width="26dp"
                android:layout_height="26dp">

                <ImageView
                    android:id="@+id/episode_play_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/play_episode"
                    android:src="@drawable/ic_baseline_play_arrow_24"
                    app:tint="@color/white" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/episode_progress"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:visibility="gone"
                    app:indicatorColor="#E11D48"
                    app:indicatorSize="26dp"
                    app:trackColor="#44FFFFFF"
                    app:trackThickness="2dp"
                    tools:progress="50"
                    tools:visibility="visible" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/episode_filler"
                style="@style/SmallWhiteButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/filler" />

            <TextView
                android:id="@+id/episode_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                tools:text="1. Jobless" />
        </LinearLayout>

        <com.lagradost.cloudstream3.ui.download.button.PieFetchButton
            android:id="@+id/download_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp" />
    </FrameLayout>
</androidx.cardview.widget.CardView>
